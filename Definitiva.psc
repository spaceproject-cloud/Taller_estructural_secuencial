Algoritmo Definitiva
	Definir n1, n2, n3, n4 , df Como Real
	Escribir "Ingrese el valor de la nota 1 "
	Leer  n1
	Escribir "Ingrese el valor de la nota 2 "
	Leer  n2
	Escribir "Ingrese el valor de la nota 3 "
	Leer n3
	Escribir "Ingrese el valor de la nota 4 "
	Leer n4
	df = (n1+n2+n3+n4 )/ 4
	Escribir "La definitiva es " , df
	
FinAlgoritmo
